{
  "functions": {
    "api/simulate.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/web/assets/favicon.ico"
    },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/web/assets/apple-touch-icon.png"
    },
    {
      "source": "/assets/:path*",
      "destination": "/web/assets/:path*"
    },
    {
      "source": "/app.js",
      "destination": "/web/app.js"
    },
    {
      "source": "/style.css",
      "destination": "/web/style.css"
    }
  ]
}
